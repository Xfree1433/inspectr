# Copy to .env and fill in values

# Enables the demo banner in the UI
VITE_DEMO=true

# Port for the Express server (default: 3001)
PORT=3002

# POST /api/reset-demo restores the seeded demo org only. It returns 404
# unless ENABLE_DEMO_RESET=true, then fails closed: if RESET_SECRET is unset
# or the request's X-Reset-Secret header doesn't match, the call returns 403.
# Generate with: openssl rand -base64 24
ENABLE_DEMO_RESET=false
RESET_SECRET=

# Frontend origin allowed to call the API in production. Required in prod —
# if unset, all cross-origin requests are blocked. In development CORS is
# permissive.
# ALLOWED_ORIGIN=https://inspectr.plainspokenfoundrynine.com

# Set to "production" to enforce CORS and other production-only behavior.
# NODE_ENV=production
