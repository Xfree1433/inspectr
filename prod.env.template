# INSPECTR — production .env template
#
# Copy to .env on the production host and fill in REAL values.
# Do not commit the filled-in copy — .env is gitignored for a reason.
#
# Quickstart:
#   cp prod.env.template .env
#   # then edit .env with the values below
#
# ─────────────────────────────────────────────────────────────────────────

# Enable production-only behavior in server/index.js (strict CORS, etc.)
NODE_ENV=production

# Hide the dev demo banner in the SPA
VITE_DEMO=false

# Port the Express server listens on (must match what Nginx / Cloudflare
# Tunnel forwards to)
PORT=3001

# POST /api/reset-demo restores the seeded demo org ("demo-org") only — it
# never touches customer orgs. The route does not exist (404) unless
# ENABLE_DEMO_RESET=true; when enabled it also needs RESET_SECRET in the
# X-Reset-Secret header (403 otherwise, fail-closed).
# Generate the secret with: openssl rand -base64 24
ENABLE_DEMO_RESET=false
RESET_SECRET=PASTE_OPENSSL_OUTPUT_HERE

# REQUIRED — origin the frontend will be served from. If unset, all
# cross-origin requests are blocked outright in production.
# Use the exact scheme + host (no trailing slash, no path).
ALLOWED_ORIGIN=https://inspectr.plainspokenfoundrynine.com

# Path to the SQLite database file. Must be on a persistent volume.
# Under the canonical docker-compose deploy this is /data/inspectr.db
# (mounted from the inspectr-data volume). If unset, server/db.js falls
# back to server/inspectr.db inside the container — which disappears on
# every rebuild. Set it explicitly in prod.
SQLITE_PATH=/data/inspectr.db

# ── Password reset by email ("Forgot password?") ────────────────────────────
# Signs the emailed reset links (HMAC). REQUIRED in production, at least 16
# characters: without it no reset email is ever sent. Changing it kills every
# outstanding link. Generate with: openssl rand -base64 32
SESSION_SECRET=PASTE_OPENSSL_OUTPUT_HERE

# The links point here; never taken from the request's Host header.
APP_BASE_URL=https://inspectr.plainspokenfoundrynine.com

# Plain SMTP. With MAIL_SERVER or MAIL_PASSWORD unset the form still answers
# normally and the server logs "password reset email not sent: mail not configured".
# Port 465 = implicit TLS; otherwise STARTTLS is required unless MAIL_USE_TLS=false.
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=PF9 Support <support@plainspokenfoundrynine.com>
